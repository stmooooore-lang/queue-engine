# Poller image - runs on GitHub Actions runner (not VM)
# Based on node:20-slim, installs @libsql/client and docker CLI, runs poller.mjs
# This container's only job: poll Turso, and for each task, shell out to
# docker run --rm ... plexus-render:latest cline ... to run Cline.
# It does NOT need Cline or LiteLLM itself.

FROM node:20-slim

WORKDIR /app

# Install docker CLI (to spawn plexus-render:latest containers from within)
# Also install git for init-tasks-md.mjs's git pull at startup
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    gnupg \
    lsb-release \
    && curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/debian $(lsb_release -cs) stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update && apt-get install -y --no-install-recommends docker-ce-cli \
    && rm -rf /var/lib/apt/lists/*

# @libsql/client: native module, node:20-slim has the build toolchain.
# No markdown library needed - poller.mjs converts to Telegram HTML with a
# small hand-written function (fewer characters to escape than MarkdownV2,
# more predictable on real multi-paragraph Cline output).
RUN npm install @libsql/client@0.14.0 --omit=dev

# Allow git to operate on the plexus-doc directory (system-level, survives HOME mount)
# and give it a commit identity - init-tasks-md.mjs commits as this container,
# not as a human, and git refuses to commit with no identity configured at all.
RUN git config --system --add safe.directory /home/runner/plexus-doc && \
    git config --system user.email "poller@queue-engine" && \
    git config --system user.name "queue-engine poller"

# Copy poller scripts
COPY scripts/poller.mjs /app/poller.mjs
COPY scripts/init-tasks-md.mjs /app/init-tasks-md.mjs
# LANE_CONFIG in poller.mjs reads these by relative path ("./prompts/<lane>.md")
# from the process cwd, which is WORKDIR /app - missing this COPY crashed the
# whole poll loop (not just one task) on the first message routed through the
# lane-routing patch (STACK-04, commit 577cf00) with ENOENT, because nobody
# rebuilt the image between that commit landing and a real message arriving.
COPY scripts/prompts /app/prompts

# Entry point
ENTRYPOINT ["node", "poller.mjs"]