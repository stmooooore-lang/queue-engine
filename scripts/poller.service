[Unit]
Description=Telegram Bot Task Queue Poller
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=runner
WorkingDirectory=/home/runner
# Run the dedicated poller image (built on GitHub Actions runner, transferred via docker save/load)
# Mount docker.sock so the poller container can spawn plexus-render:latest containers for each task
ExecStart=/usr/bin/docker run --rm --name poller \
  -v /var/run/docker.sock:/var/run/docker.sock \
  -v /run/secrets:/run/secrets:ro \
  -v /home/runner/.cline:/home/runner/.cline \
  --env-file /run/secrets/poller.env \
  poller:latest
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/runner /run/secrets
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target